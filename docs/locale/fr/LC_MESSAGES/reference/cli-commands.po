msgstr ""

#: ../../home/claude/work/docs_audit/docs_out/reference/cli-commands.md:7
msgid ""
"SAR polarisation e.g. VV, VH, HH, HV. Same Copernicus-only caveat as "
"--product-type."
msgstr ""
"Polarisation SAR, p. ex. VV, VH, HH, HV. Même réserve limitée à Copernicus "
"que pour --product-type."

