msgid "Field"
msgstr "Feld"

#: ../../home/claude/work/docs_audit/docs_out/processing/sar-insar/optical-offset-tracking.md:8
msgid "Meaning"
msgstr "Bedeutung"

#: ../../home/claude/work/docs_audit/docs_out/processing/sar-insar/optical-offset-tracking.md:8
msgid "`dx`, `dy`"
msgstr ""

#: ../../home/claude/work/docs_audit/docs_out/processing/sar-insar/optical-offset-tracking.md:8
msgid "East/North displacement per window, metres"
msgstr "Ost-/Nordverschiebung pro Fenster, in Metern"

#: ../../home/claude/work/docs_audit/docs_out/processing/sar-insar/optical-offset-tracking.md:8
msgid "`snr`"
msgstr ""

#: ../../home/claude/work/docs_audit/docs_out/processing/sar-insar/optical-offset-tracking.md:8
msgid ""
"Primary-peak-to-secondary-peak ratio — the correlation confidence signal"
msgstr ""
"Verhältnis von Hauptpeak zu Nebenpeak – das Konfidenzsignal der Korrelation"

#: ../../home/claude/work/docs_audit/docs_out/processing/sar-insar/optical-offset-tracking.md:8
