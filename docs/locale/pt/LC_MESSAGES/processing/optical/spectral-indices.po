msgstr "Sentinel-2 / Landsat — calculável diretamente"

#: ../../home/claude/work/docs_audit/docs_out/processing/optical/spectral-indices.md:613
msgid "`AMP` (Amphibole)"
msgstr "`AMP` (Amphibole)"

#: ../../home/claude/work/docs_audit/docs_out/processing/optical/spectral-indices.md:613
msgid "`SWIR1 / SWIR2`"
msgstr ""

