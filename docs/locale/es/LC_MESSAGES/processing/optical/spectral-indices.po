msgid "Method"
msgstr "Método"

#: ../../home/claude/work/docs_audit/docs_out/processing/optical/spectral-indices.md:43
msgid "What it's for"
msgstr "Para qué sirve"

#: ../../home/claude/work/docs_audit/docs_out/processing/optical/spectral-indices.md:43
msgid "Real basis"
msgstr "Base real"

#: ../../home/claude/work/docs_audit/docs_out/processing/optical/spectral-indices.md:43
msgid "`tct()`"
msgstr ""

#: ../../home/claude/work/docs_audit/docs_out/processing/optical/spectral-indices.md:43
msgid ""
"**Tasseled Cap Transformation** — 3-band Brightness/Greenness/Wetness "
"summary, a classic land-cover-change screening tool"
msgstr ""
"**Transformación Tasseled Cap** — resumen de 3 bandas de "
"Brillo/Verdor/Humedad, una herramienta clásica de cribado de cambios en la "
"cobertura del suelo"

#: ../../home/claude/work/docs_audit/docs_out/processing/optical/spectral-indices.md:43
msgid ""
"Nedkov (2017) for Sentinel-2, Baig et al. (2014) for Landsat-8 — published "
"coefficients"
msgstr ""
"Nedkov (2017) para Sentinel-2, Baig et al. (2014) para Landsat-8 — "
"coeficientes publicados"

